---
import { canonicalUrl, siteInfo, siteUrl, type ArticleMetadata } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  article?: ArticleMetadata;
}

const { title, description, article } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const root = canonicalUrl("/", Astro.site);
const image = siteUrl(siteInfo.image, Astro.site).href;
const author = { "@type": "Person", name: siteInfo.author, url: canonicalUrl("/about/", Astro.site), sameAs: [siteInfo.profile] };
const structuredData = article ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description,
  url: canonical,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  image: [image],
  inLanguage: "zh-CN",
  datePublished: article.publishedAt.toISOString(),
  dateModified: (article.updatedAt ?? article.publishedAt).toISOString(),
  author,
  publisher: author,
  keywords: article.tags?.join(", "),
  isPartOf: { "@type": "WebSite", name: siteInfo.name, url: root },
} : {
  "@context": "https://schema.org",
  "@type": Astro.url.pathname === "/" ? "WebSite" : "WebPage",
  name: title,
  description,
  url: canonical,
  inLanguage: "zh-CN",
  author,
};
// Escape HTML delimiters so a Markdown title cannot terminate this script element.
const jsonLd = JSON.stringify(structuredData).replace(/</g, "\\u003c").replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029");
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={siteInfo.author} />
<meta name="theme-color" content="#fff8f0" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)" />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content={siteInfo.name} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={siteInfo.imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={siteInfo.imageAlt} />
{article && <>
  <meta property="article:published_time" content={article.publishedAt.toISOString()} />
  <meta property="article:modified_time" content={(article.updatedAt ?? article.publishedAt).toISOString()} />
  <meta property="article:author" content={author.url} />
  {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
</>}
<script is:inline type="application/ld+json" set:html={jsonLd} />

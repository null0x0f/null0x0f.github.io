---
interface Props { current?: "blog" | "weekly" | "about"; }
const { current } = Astro.props;
---
<header class="site-header">
  <div class="shell nav-wrap">
    <a class="brand" href="/" aria-label="Felix Ding，返回首页">Felix Ding<span>.</span></a>
    <button class="nav-action menu-toggle" type="button" data-menu-toggle aria-label="打开导航" aria-expanded="false" aria-controls="main-navigation">☰</button>
    <nav class="site-nav" id="main-navigation" aria-label="主导航">
      <a href="/" aria-current={!current ? "page" : undefined}>首页</a>
      <a href="/blog/" aria-current={current === "blog" ? "page" : undefined}>文章</a>
      <a href="/weekly/" aria-current={current === "weekly" ? "page" : undefined}>周报</a>
      <a href="/about/" aria-current={current === "about" ? "page" : undefined}>关于</a>
    </nav>
    <div class="nav-tools">
      <button class="nav-action" type="button" data-search-open aria-label="搜索文章"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg></button>
      <button class="nav-action" type="button" data-theme-toggle aria-label="切换主题">☾</button>
    </div>
  </div>
</header>

---
interface Props {
  username: string;
}

const { username } = Astro.props;
const profileUrl = `https://github.com/${username}`;
---

<section class="section github-section" id="github-activity" data-reveal>
  <div class="shell">
    <header class="section-head">
      <span class="section-index">02</span>
      <div>
        <p class="section-label">Open source activity</p>
        <h2>持续构建，也持续留下记录</h2>
      </div>
      <a class="text-link" href={profileUrl} target="_blank" rel="noreferrer">@{username}</a>
    </header>

    <div class="contribution-panel" data-github-contributions data-username={username} aria-busy="true">
      <div class="contribution-summary" aria-live="polite">
        <div>
          <strong data-contribution-total>--</strong>
          <span>过去一年的公开贡献</span>
        </div>
        <span class="contribution-sync">
          <span class="live-indicator"><i></i><span data-contribution-state>正在检查 GitHub</span></span>
          <button class="contribution-refresh" type="button" data-contribution-refresh aria-label="刷新 GitHub 贡献" title="刷新 GitHub 贡献">↻</button>
        </span>
      </div>

      <div class="contribution-scroll" tabindex="0" aria-label="GitHub 贡献日历，可横向滚动">
        <div class="contribution-calendar">
          <div class="contribution-months" data-contribution-months aria-hidden="true"></div>
          <div class="contribution-body">
            <div class="contribution-weekdays" aria-hidden="true"><span>一</span><span>三</span><span>五</span></div>
            <div class="contribution-grid is-loading" data-contribution-grid role="img" aria-label={`${username} 过去一年的 GitHub 贡献正在加载`}></div>
          </div>
        </div>
      </div>

      <div class="contribution-footer">
        <span data-contribution-range>最近 12 个月</span>
        <div class="contribution-legend" aria-label="贡献强度从少到多">
          <span>少</span><i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i><span>多</span>
        </div>
      </div>
      <div class="contribution-tooltip" data-contribution-tooltip hidden></div>
    </div>
  </div>
</section>

<script is:inline src="/github-contributions.js"></script>

---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { GetStaticPaths } from "astro";
export const getStaticPaths = (async () => { const posts = await getCollection("blog", ({ data }) => !data.draft); return posts.map((post) => ({ params: { slug: post.id }, props: { post } })); }) satisfies GetStaticPaths;
const { post } = Astro.props;
const { Content, headings } = await render(post);
const date = post.data.publishedAt.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={`${post.data.title} — Jackie Null`} description={post.data.description} current="blog"><main><header class="shell article-header"><div class="breadcrumbs"><a href="/blog">Blog</a><span>/</span><span>{post.data.tags[0]}</span></div><h1>{post.data.title}</h1><p class="article-dek">{post.data.description}</p><div class="article-meta"><span>{date}</span><span>{Math.max(1, Math.ceil((post.body?.length ?? 0) / 900))} 分钟阅读</span>{post.data.updatedAt && <span>最后更新于 {post.data.updatedAt.toLocaleDateString("zh-CN", { month: "numeric", day: "numeric" })}</span>}</div></header><div class="shell article-layout"><article class="prose"><Content /></article><aside class="toc"><strong>本页目录</strong>{headings.filter((heading) => heading.depth <= 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</aside></div></main></BaseLayout>

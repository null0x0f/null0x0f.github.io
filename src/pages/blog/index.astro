---
import { getCollection } from "astro:content";
import EditorialLayout from "@/layouts/EditorialLayout.astro";
import { siteInfo } from "@/lib/site";
import "@/styles/archive.css";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const years = [...new Set(posts.map((post) => post.data.publishedAt.getFullYear()))];
const topics = [...new Map(posts.flatMap((post) => post.data.tags).map((tag) => [tag.toLowerCase(), tag])).values()];
const numbers = new Map(posts.map((post, index) => [post.id, String(index + 1).padStart(2, "0")]));
const formatDate = (date: Date) => date.toLocaleDateString("en-GB", {
  year: "numeric", month: "2-digit", day: "2-digit",
}).split("/").reverse().join(".");
---

<EditorialLayout title={`INDEX — 文章归档 | ${siteInfo.name}`} description="关于 C++、Qt、嵌入式与工业软件的技术文章。把问题写清楚，把经验留下来。" current="blog">
  <main id="main-content" class="archive-shell archive-index">
    <header class="archive-cover">
      <div class="archive-cover-meta"><span>THE UNFINISHED ARCHIVE</span><span>WRITING / 01</span></div>
      <h1>INDEX<span class="archive-cover-mark" aria-hidden="true"></span><span class="sr-only"> / 文章归档</span></h1>
      <div class="archive-cover-intro">
        <p class="archive-cover-statement">把问题写清楚，<br />把经验留下来。</p>
        <p class="archive-cover-description">关于代码、系统与持续学习的个人记录。<br />从一个具体的问题开始，寻找可以复用的答案。</p>
      </div>
    </header>

    <section class="archive-catalog" aria-label="按年份排列的文章归档">
      <div class="archive-toolbar">
        <p><span data-result-count aria-live="polite" aria-atomic="true">{posts.length} 篇内容</span><span class="archive-order"> / 按发布时间</span></p>
        <label class="archive-filter">
          <span>主题</span>
          <select data-blog-filter aria-label="按主题筛选文章">
            <option value="all">全部文章</option>
            {topics.map((topic) => <option value={topic.toLowerCase()}>{topic}</option>)}
          </select>
        </label>
      </div>

      <div class="archive-year-list">
        {years.map((year) => {
          const yearPosts = posts.filter((post) => post.data.publishedAt.getFullYear() === year);
          return (
            <section class="archive-year" data-archive-year aria-labelledby={`year-${year}`}>
              <header class="archive-year-heading">
                <h2 id={`year-${year}`}>{year}</h2>
                <span data-year-count>{yearPosts.length} 篇记录</span>
              </header>
              <div class="archive-entries">
                {yearPosts.map((post) => (
                  <a class="archive-index-entry" data-topic={JSON.stringify(post.data.tags.map((tag) => tag.toLowerCase()))} href={`/blog/${post.id}/`}>
                    <span class="archive-entry-number" aria-hidden="true">{numbers.get(post.id)}</span>
                    <div class="archive-entry-copy">
                      <h3>{post.data.title}</h3>
                      <p>{post.data.description}</p>
                    </div>
                    <div class="archive-entry-meta">
                      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                      {post.data.tags.length > 0 && <span class="archive-entry-tags">{post.data.tags.slice(0, 3).join(" / ")}</span>}
                    </div>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
        {!posts.length && <p class="archive-empty">第一篇记录正在酝酿中。</p>}
      </div>

      <div class="archive-end"><span>END OF INDEX</span><p>保持好奇，继续构建。</p></div>
    </section>
  </main>
</EditorialLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const years = [...new Set(posts.map((post) => post.data.publishedAt.getFullYear()))];
const topics = [...new Map(posts.flatMap((post) => post.data.tags).map((tag) => [tag.toLowerCase(), tag])).values()];
const shortDate = (value: Date) => value.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" });
---
<BaseLayout title="文章 — Felix Ding" description="关于 C++、Qt、嵌入式与工业软件的技术文章。" current="blog">
  <main class="shell essay-index">
    <header class="essay-intro">
      <div><p class="eyebrow">Writing</p><h1>工程笔记与思考</h1><p>把问题写清楚，把经验留下来。<br />关于软件、系统与持续学习的记录。</p></div>
      <figure class="essay-illustration"><img src="/images/bleach/pingzi.jpg" alt="坐在书籍与唱片之间阅读的 BLEACH 漫画人物" width="800" height="1176" decoding="async" fetchpriority="high" /></figure>
    </header>
    <div class="essay-toolbar"><span data-result-count aria-live="polite">{posts.length} 篇内容</span><label class="topic-select"><span class="sr-only">按主题筛选文章</span><select data-blog-filter aria-label="按主题筛选文章"><option value="all">全部主题</option>{topics.map((topic) => <option value={topic.toLowerCase()}>{topic}</option>)}</select></label></div>
    <div class="essay-years">
      {years.map((year) => <section class="essay-year" data-archive-year aria-labelledby={`year-${year}`}><header><h2 id={`year-${year}`}>{year}</h2><span class="sr-only" data-year-count>{posts.filter((post) => post.data.publishedAt.getFullYear() === year).length} 篇记录</span></header><div>{posts.filter((post) => post.data.publishedAt.getFullYear() === year).map((post) => <a class="essay-entry" href={`/blog/${post.id}/`} data-topic={JSON.stringify(post.data.tags.map((tag) => tag.toLowerCase()))}><time datetime={post.data.publishedAt.toISOString()}>{shortDate(post.data.publishedAt)}</time><div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="essay-entry-tags">{post.data.tags.slice(0, 3).join(" · ")}</span></div></a>)}</div></section>)}
      {!posts.length && <p class="empty-message">第一篇文章正在酝酿中。</p>}
    </div>
  </main>
</BaseLayout>

---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import EditorialLayout from "@/layouts/EditorialLayout.astro";
import ReadingFrame from "@/components/editorial/ReadingFrame.astro";
import { getPublishedWeekly } from "@/lib/weekly";
import { formatWeeklyDate, getWeekInfo } from "@/lib/weekly-dates";
import { siteInfo } from "@/lib/site";

export const getStaticPaths = (async () => {
  const entries = await getPublishedWeekly();
  return entries.map((entry, index) => ({ params: { slug: entry.id }, props: { entry, older: entries[index + 1], newer: entries[index - 1] } }));
}) satisfies GetStaticPaths;
const { entry, older, newer } = Astro.props;
const { Content, headings } = await render(entry);
const week = getWeekInfo(entry.data.weekOf);
---
<EditorialLayout title={`${entry.data.title} · ${week.label} — ${siteInfo.author}`} description={entry.data.description} current="weekly" article={entry.data}>
  <main id="main-content" class="reading-page weekly-reading-page">
    <header class="archive-shell reading-cover edition-cover">
      <div class="reading-cover-top"><nav aria-label="面包屑"><a href="/weekly/">周报归档</a><span aria-hidden="true">/</span><span>{week.label}</span></nav><span class="micro">WEEKLY EDITIONS / {week.isoYear}</span></div>
      <div class="edition-cover-grid"><div class="edition-cover-number"><span>WEEK</span><strong>{week.number}</strong><p class="micro">{week.range}</p></div><div class="edition-cover-copy"><p class="reading-category micro">A WEEK IN PROGRESS</p><h1>{entry.data.title}</h1><p class="reading-dek">{entry.data.description}</p>{entry.data.tags.length > 0 && <p class="edition-cover-tags">{entry.data.tags.join(" / ")}</p>}</div></div>
      <div class="reading-byline"><a href="/about/">{siteInfo.author}</a><span>发布于 <time datetime={entry.data.publishedAt.toISOString()}>{formatWeeklyDate(entry.data.publishedAt)}</time></span><span>约 {Math.max(1, Math.ceil((entry.body?.length ?? 0) / 900))} 分钟阅读</span>{entry.data.updatedAt && <span>更新于 <time datetime={entry.data.updatedAt.toISOString()}>{formatWeeklyDate(entry.data.updatedAt)}</time></span>}</div>
    </header>
    <ReadingFrame headings={headings.filter(({ depth }) => depth <= 2)} label="本期目录" archiveHref="/weekly/" archiveLabel="返回周报归档">
      <Content />
      <Fragment slot="footer"><div class="reading-end"><span class="micro">END OF EDITION / W{week.number}</span><a class="underlined-link" href="/weekly/">返回周报归档</a></div><nav class="reading-pager" aria-label="前后期周报">{older ? <a href={`/weekly/${older.id}/`}><span>上一期 · {getWeekInfo(older.data.weekOf).label}</span><strong>{older.data.title}</strong></a> : <p>已是最早的一期</p>}{newer ? <a href={`/weekly/${newer.id}/`}><span>下一期 · {getWeekInfo(newer.data.weekOf).label}</span><strong>{newer.data.title}</strong></a> : <p>已是最新的一期</p>}</nav></Fragment>
    </ReadingFrame>
  </main>
</EditorialLayout>

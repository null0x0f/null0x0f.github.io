---
import EditorialLayout from "@/layouts/EditorialLayout.astro";
import { siteInfo } from "@/lib/site";
import { getPublishedWeekly } from "@/lib/weekly";
import { formatWeeklyDate, getWeekInfo } from "@/lib/weekly-dates";
import "@/styles/weekly-archive.css";

const entries = await getPublishedWeekly();
const latest = entries[0];
const latestWeek = latest && getWeekInfo(latest.data.weekOf);
const years = [...new Set(entries.map(({ data }) => getWeekInfo(data.weekOf).year))];
const months = [...new Set(entries.map(({ data }) => data.weekOf.slice(0, 7)))];
---

<EditorialLayout title={`WEEKLY — 周报 | ${siteInfo.name}`} description="以周为单位，记录开发进展、问题与解法、学习收获和下周计划。" current="weekly">
  <main id="main-content" class="archive-shell journal-index">
    <header class="journal-cover">
      <div class="journal-cover-meta"><span>THE UNFINISHED ARCHIVE</span><span>WEEKLY / 02</span></div>
      <div class="journal-cover-title">
        <h1>WEEKLY<span aria-hidden="true">.</span><span class="sr-only"> / 周报</span></h1>
        <p>每周一记，<br />慢慢积累。</p>
      </div>
      <p class="journal-cover-description">技术文章记录一个问题的答案，周报记录走到答案的过程。<br class="journal-desktop-break" />写下开发中的进展、卡住的瞬间，以及这一周的新收获。</p>
    </header>

    {latest && latestWeek && (
      <section class="journal-current" aria-labelledby="latest-weekly-heading">
        <a class="journal-current-link" href={`/weekly/${latest.id}/`}>
          <div class="journal-current-issue">
            <span>WEEK / {latestWeek.isoYear}</span>
            <strong aria-label={`第 ${latestWeek.number} 周`}>{latestWeek.number}</strong>
            <time datetime={latest.data.weekOf}>{latestWeek.range}</time>
          </div>
          <div class="journal-current-copy">
            <p class="journal-current-label">最新一期 / LATEST EDITION</p>
            <h2 id="latest-weekly-heading">{latest.data.title}</h2>
            <p class="journal-current-description">{latest.data.description}</p>
            {latest.data.tags.length > 0 && <p class="journal-current-tags">{latest.data.tags.join(" / ")}</p>}
            <span class="journal-current-read">阅读本期</span>
          </div>
        </a>
      </section>
    )}

    <section class="journal-archive" aria-labelledby="weekly-archive-heading" data-weekly-archive>
      <header class="journal-archive-heading">
        <div><p class="journal-section-label">THE WEEKLY INDEX</p><h2 id="weekly-archive-heading">每一周，都有迹可循。</h2></div>
        <span data-weekly-count aria-live="polite" aria-atomic="true">{entries.length ? `已记录 ${entries.length} 期` : "记录即将开始"}</span>
      </header>
      {entries.length > 0 ? (
        <>
          <form class="journal-filters" role="search" aria-label="筛选周报" data-weekly-filters hidden>
            <label class="journal-search">
              <span class="sr-only">搜索周报标题、摘要、标签或周次</span>
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
              <input type="search" name="q" placeholder="搜索标题、标签或周次" autocomplete="off" data-weekly-query />
            </label>
            <label class="journal-year-filter"><span class="sr-only">按年份筛选周报</span><select name="year" data-weekly-year><option value="all">全部年份</option>{years.map((year) => <option value={year}>{year} 年</option>)}</select></label>
            <button class="journal-reset" type="reset" hidden data-weekly-reset>重置筛选</button>
          </form>
          <div class="journal-months">
            {months.map((month) => {
              const group = entries.filter(({ data }) => data.weekOf.startsWith(month));
              const firstWeek = getWeekInfo(group[0].data.weekOf);
              return (
                <section class="journal-month" data-weekly-month aria-labelledby={`month-${month}`}>
                  <h3 id={`month-${month}`}><span>{firstWeek.monthLabel}</span><small>{group.length} 期</small></h3>
                  <div class="journal-entries">{group.map((entry) => {
                    const week = getWeekInfo(entry.data.weekOf);
                    return (
                      <a class="journal-entry" href={`/weekly/${entry.id}/`} data-weekly-entry data-year={week.year} data-search={["周报", entry.data.title, entry.data.description, week.label, week.range, ...entry.data.tags].join(" ")}>
                        <span class="journal-entry-issue"><strong>W{week.number}</strong><span>{week.isoYear}</span></span>
                        <div class="journal-entry-copy">
                          <h4>{entry.data.title}</h4>
                          <p>{entry.data.description}</p>
                          <div class="journal-entry-meta"><time datetime={entry.data.weekOf}>{week.range}</time>{entry.data.tags.length > 0 && <span>{entry.data.tags.join(" / ")}</span>}</div>
                        </div>
                        <span class="journal-entry-published">发布于<time datetime={entry.data.publishedAt.toISOString()}>{formatWeeklyDate(entry.data.publishedAt)}</time></span>
                      </a>
                    );
                  })}</div>
                </section>
              );
            })}
          </div>
          <div class="journal-no-results" data-weekly-no-results hidden><h3>没有找到匹配的记录。</h3><p>试试其他关键词，或切换年份。</p><button class="journal-reset" type="button" data-weekly-clear>查看全部周报</button></div>
        </>
      ) : (
        <div class="journal-empty">
          <p class="journal-empty-mark">TO BE<br />CONTINUED<span aria-hidden="true">.</span></p>
          <div><h3>第一篇周报，正在酝酿中。</h3><p>这里会慢慢积累开发记录、问题复盘和学习收获。在此之前，可以先读读已经整理好的技术文章。</p><a class="underlined-link" href="/blog/">去读技术文章</a></div>
        </div>
      )}
      <div class="journal-end"><span>END OF EDITIONS</span><p>以周为单位，给思考留一点空间。</p></div>
    </section>
  </main>
</EditorialLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedWeekly } from "@/lib/weekly";
import { getWeekInfo } from "@/lib/weekly-dates";

const entries = await getPublishedWeekly();
const years = [...new Set(entries.map(({ data }) => getWeekInfo(data.weekOf).year))];
const months = [...new Set(entries.map(({ data }) => data.weekOf.slice(0, 7)))];
---

<BaseLayout title="周报 — Felix Ding" description="以周为单位，记录开发进展、问题与解法、学习收获和下周计划。" current="weekly">
  <main class="shell journal-page">
    <header class="journal-heading">
      <p class="eyebrow">Weekly journal</p>
      <h1>每周一记。</h1>
      <p>写下开发中的进展、卡住的瞬间，以及这一周的新收获。<br class="journal-heading-break" />以周为单位，给思考留一点空间。</p>
    </header>

    <section class="journal-archive" aria-labelledby="journal-archive-heading" data-weekly-archive>
      <header class="journal-archive-head">
        <h2 id="journal-archive-heading">所有周报</h2>
        <span data-weekly-count aria-live="polite">{entries.length ? `已记录 ${entries.length} 期` : "记录即将开始"}</span>
      </header>
      {entries.length > 0 ? (
        <>
          <form class="journal-filters" role="search" data-weekly-filters hidden>
            <label class="journal-search">
              <span class="sr-only">搜索周报标题、摘要、标签或周次</span>
              <input type="search" name="q" placeholder="搜索周报" autocomplete="off" data-weekly-query />
            </label>
            <label class="journal-year">
              <span class="sr-only">按年份筛选</span>
              <select name="year" data-weekly-year>
                <option value="all">全部年份</option>
                {years.map((year) => <option value={year}>{year} 年</option>)}
              </select>
            </label>
            <button class="journal-reset" type="reset" hidden data-weekly-reset>重置筛选</button>
          </form>
          <div class="journal-months">
            {months.map((month) => {
              const group = entries.filter(({ data }) => data.weekOf.startsWith(month));
              const firstWeek = getWeekInfo(group[0].data.weekOf);
              return <section class="journal-month" data-weekly-month>
                <h3>{firstWeek.monthLabel}<small>{group.length} 期</small></h3>
                <div class="journal-entries">{group.map((entry) => {
                  const week = getWeekInfo(entry.data.weekOf);
                  return <article class="journal-entry" data-weekly-entry data-year={week.year} data-search={["周报", entry.data.title, entry.data.description, week.label, week.range, ...entry.data.tags].join(" ")}>
                    <time datetime={entry.data.weekOf}>{week.range}</time>
                    <h4><a href={`/weekly/${entry.id}/`}>{entry.data.title}</a></h4>
                    <p>{entry.data.description}</p>
                    {entry.data.tags.length > 0 && <p class="journal-entry-topics">{entry.data.tags.join(" · ")}</p>}
                  </article>;
                })}</div>
              </section>;
            })}
          </div>
          <div class="journal-no-results" data-weekly-no-results hidden>
            <h3>没有找到匹配的周报</h3>
            <p>试试其他关键词，或切换年份。</p>
            <button class="text-link" type="button" data-weekly-clear>查看全部周报</button>
          </div>
        </>
      ) : (
        <div class="journal-empty">
          <h3>第一篇周报，正在酝酿中。</h3>
          <p>这里会慢慢积累开发记录、问题复盘和学习收获。</p>
          <a class="text-link internal" href="/blog">阅读技术文章</a>
        </div>
      )}
    </section>
  </main>
</BaseLayout>

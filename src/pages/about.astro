---
import { getCollection } from "astro:content";
import EditorialLayout from "@/layouts/EditorialLayout.astro";
import { siteInfo } from "@/lib/site";
import "@/styles/profile.css";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const projects = ["horizontal_45kw_lxn06", "工业后端项目复盘", "250ets"].flatMap((id) => {
  const post = posts.find((entry) => entry.id === id);
  return post ? [post] : [];
});
const principles = [
  { title: "先建立边界", description: "明确模块职责、失败方式和数据所有权，再选择具体技术。" },
  { title: "为诊断而设计", description: "系统不只要工作，还要能解释为什么没有工作。" },
  { title: "保持工具简单", description: "减少隐式状态，让操作结果清楚、可撤销、可重复。" },
];
const focus = [
  { label: "Core", title: "C++ · Qt · Embedded Linux", description: "应用架构、性能、并发与设备集成" },
  { label: "Protocol", title: "Modbus · CAN · RS485", description: "工业协议、现场诊断与数据采集" },
  { label: "Tools", title: "CMake · Git · Python", description: "构建系统、自动化测试与工程效率" },
];
---

<EditorialLayout title={"About — " + siteInfo.author + " · NULL / 0x0F"} description={"关于 " + siteInfo.author + "：软件工程、设备通信与代码之外。"} current="about">
  <main id="main-content" class="archive-shell profile-page">
    <header class="profile-cover">
      <div class="profile-cover-meta micro"><span>PERSONAL FILE / 作者档案</span><span>THE UNFINISHED ARCHIVE</span></div>
      <h1 class="profile-title">SUBJECT <span><i aria-hidden="true">/</i><span class="sr-only"> / </span>0x0F</span></h1>
      <div class="profile-intro">
        <div class="profile-identity"><span class="micro">NAME / 姓名</span><h2>{siteInfo.author}</h2><p class="micro">SOFTWARE &amp; SYSTEMS ENGINEER</p></div>
        <div class="profile-opening"><p>一名关注可靠性与实际交付的软件工程师，主要工作在桌面软件、嵌入式设备和工业现场之间。</p><div class="profile-links"><a class="underlined-link" href="/blog/">阅读文章</a><a class="underlined-link" href={siteInfo.profile} target="_blank" rel="noreferrer">GitHub</a></div></div>
      </div>
    </header>

    <section class="profile-section" aria-labelledby="profile-now">
      <header class="profile-section-heading"><p class="micro">01 / NOW</p><h2 id="profile-now">现在</h2></header>
      <div class="profile-section-content profile-prose"><p class="profile-lead">专注工业软件与设备通信。</p><p>我目前专注于 C++ / Qt 工业软件、设备通信和工程工具链。喜欢把难以观察的系统状态变得清晰，让复杂操作成为可理解、可恢复的工作流。</p><p>这个网站用于记录真实问题、工程决策和那些值得反复查阅的技术细节。</p></div>
    </section>

    <section class="profile-section" aria-labelledby="profile-principles">
      <header class="profile-section-heading"><p class="micro">02 / PRINCIPLES</p><h2 id="profile-principles">工作方式</h2></header>
      <div class="profile-section-content"><ol class="profile-principles">{principles.map((principle, index) => <li><span class="profile-item-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><div><h3>{principle.title}</h3><p>{principle.description}</p></div></li>)}</ol></div>
    </section>

    <section class="profile-section" aria-labelledby="profile-focus">
      <header class="profile-section-heading"><p class="micro">03 / FOCUS</p><h2 id="profile-focus">关注方向</h2></header>
      <div class="profile-section-content"><dl class="profile-focus-list">{focus.map((item) => <div><dt class="micro">{item.label}</dt><dd><h3>{item.title}</h3><p>{item.description}</p></dd></div>)}</dl></div>
    </section>

    {projects.length > 0 && <section class="profile-section" aria-labelledby="profile-work">
      <header class="profile-section-heading"><p class="micro">04 / WORK NOTES</p><h2 id="profile-work">项目记录</h2></header>
      <div class="profile-section-content"><p class="profile-section-note">留下做过的工作，也留下问题与取舍。</p><div class="profile-projects">{projects.map((post) => <a href={"/blog/" + post.id + "/"}><p class="micro">{post.data.tags.slice(0, 3).join(" / ")}</p><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="underlined-link">阅读项目记录</span></a>)}</div></div>
    </section>}

    <section class="profile-section profile-after-hours" aria-labelledby="profile-after-hours">
      <header class="profile-section-heading"><p class="micro">05 / AFTER HOURS</p><h2 id="profile-after-hours">代码之外</h2></header>
      <div class="profile-section-content profile-interest"><p class="profile-interest-title">OFF THE<br /><span>CLOCK.</span></p><div><p>漫画、插画，还有那些想留下的画面。</p><p>BLEACH 的人物与色彩，也在这个档案馆里占有一页。</p><a class="underlined-link" href="/#after-hours">看看 After Hours</a></div></div>
    </section>
  </main>
</EditorialLayout>

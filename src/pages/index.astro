---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeHero from "@/components/HomeHero.astro";
import GitHubContributions from "@/components/GitHubContributions.astro";
import { getPublishedWeekly } from "@/lib/weekly";
import { getWeekInfo } from "@/lib/weekly-dates";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const weekly = await getPublishedWeekly();
const formatDate = (date: Date) => date.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<BaseLayout title="Felix Ding — Software & Systems">
  <main>
    <HomeHero />
    <section class="shell home-writing" aria-labelledby="recent-writing-title">
      <header class="simple-section-head"><h2 id="recent-writing-title">最近文章</h2><a class="text-link secondary-link" href="/blog/">全部文章</a></header>
      <div class="home-post-list">
        {posts.slice(0, 5).map((post) => <a class="home-post" href={`/blog/${post.id}/`}><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="home-post-topic">{post.data.tags[0]}</span></a>)}
        {!posts.length && <p class="empty-message">第一篇文章正在酝酿中。</p>}
      </div>
    </section>
    <section class="shell home-journal" aria-labelledby="home-journal-title">
      <div><p class="eyebrow">Weekly journal</p><h2 id="home-journal-title">每周一记，慢慢积累。</h2><p>开发中的进展、问题和新收获。<br />给每一周，留一点记录。</p><a class="text-link secondary-link" href="/weekly/">全部周报</a></div>
      <div class="home-journal-list">{weekly.slice(0, 3).map((entry) => <a href={`/weekly/${entry.id}/`}><span>{getWeekInfo(entry.data.weekOf).label}</span><h3>{entry.data.title}</h3><p>{entry.data.description}</p></a>)}{!weekly.length && <p class="empty-message">第一篇周报正在酝酿中。</p>}</div>
    </section>
    <div class="shell home-activity"><details><summary>GitHub 活动<span aria-hidden="true">+</span></summary><GitHubContributions username="null0x0f" /></details></div>
  </main>
</BaseLayout>

---
import { getCollection } from "astro:content";
import EditorialLayout from "@/layouts/EditorialLayout.astro";
import Cover from "@/components/editorial/Cover.astro";
import SectionHeading from "@/components/editorial/SectionHeading.astro";
import GitHubContributions from "@/components/GitHubContributions.astro";
import { siteInfo } from "@/lib/site";
import { getPublishedWeekly } from "@/lib/weekly";
import { getWeekInfo } from "@/lib/weekly-dates";
import "@/styles/home.css";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = posts.filter(({ data }) => data.featured);
const selected = [...featured, ...posts.filter((post) => !featured.includes(post))].slice(0, 3);
const [lead, ...supporting] = selected;
const weekly = await getPublishedWeekly();
const latest = weekly[0];
const latestWeek = latest && getWeekInfo(latest.data.weekOf);
const firstYear = posts.length ? Math.min(...posts.map(({ data }) => data.publishedAt.getFullYear())) : new Date().getFullYear();
const projects = ["horizontal_45kw_lxn06", "工业后端项目复盘", "250ets"].flatMap((id) => { const post = posts.find((entry) => entry.id === id); return post ? [post] : []; });
const date = (value: Date) => value.toISOString().slice(0, 10).replaceAll("-", ".");
---

<EditorialLayout title={`NULL / 0x0F — The Unfinished Archive · ${siteInfo.author}`}>
  <main id="main-content">
    <Cover articleCount={posts.length} firstYear={firstYear} />
    <section class="manifesto" id="manifesto" aria-labelledby="manifesto-title">
      <div class="archive-shell">
        <div class="section-label"><span class="section-number">02</span><span>MANIFESTO / 写在前面</span></div>
        <h2 id="manifesto-title">MAKE SENSE.<br /><span>LEAVE A TRACE.</span></h2>
        <div class="manifesto-foot"><span class="micro">THINK IN SYSTEMS.<br />WRITE IN PUBLIC.</span><p>把复杂的问题，拆成可理解的答案。<br />记录构建、调试与重新理解的过程。<br />这里没有最终版本，只有持续更新的思考。</p></div>
      </div>
    </section>

    <section class="archive-shell home-selected home-section" aria-label="精选文章">
      <SectionHeading number="03" title="SELECTED WRITING" subtitle="精选文章 / 从这里开始" />
      {lead ? <div class="selected-spread">
        <article class="selected-lead">
          <div class="selected-top micro"><span>FEATURE / 01</span><span>{date(lead.data.publishedAt)}</span></div>
          <div class="selected-type-art" aria-hidden="true"><span>{lead.data.tags[0] ?? "NOTE"}</span><span class="selected-art-line"></span><small>FIELD NOTES<br />FROM THE ARCHIVE</small></div>
          <div class="selected-lead-copy"><p class="micro">{lead.data.tags.slice(0, 3).join(" / ")}</p><h3><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h3><p>{lead.data.description}</p><a class="underlined-link" href={`/blog/${lead.id}/`}>阅读这篇文章</a></div>
        </article>
        <div class="selected-supporting">{supporting.map((post, index) => <article class="selected-secondary"><div class="selected-top micro"><span>0{index + 2} / {post.data.tags[0] ?? "NOTES"}</span><time datetime={post.data.publishedAt.toISOString()}>{date(post.data.publishedAt)}</time></div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="underlined-link" href={`/blog/${post.id}/`}>阅读全文</a></article>)}</div>
      </div> : <p class="archive-empty">档案即将开始。</p>}
    </section>

    <section class="archive-shell home-index home-section" aria-label="最新文章索引">
      <SectionHeading number="04" title="THE INDEX" subtitle={`文章索引 / ${posts.length} ENTRIES`} href="/blog/" linkText="完整归档" />
      <div class="home-index-list">{posts.slice(0, 6).map((post, index) => <a class="home-index-row" href={`/blog/${post.id}/`}><span class="index-ordinal micro">{String(index + 1).padStart(2, "0")}</span><div class="index-writing"><h3>{post.data.title}</h3><p>{post.data.tags.slice(0, 3).join(" / ")}</p></div><time class="micro" datetime={post.data.publishedAt.toISOString()}>{date(post.data.publishedAt)}</time><span class="index-open" aria-hidden="true">+</span></a>)}</div>
    </section>

    <section class="home-weekly home-section" aria-label="周报">
      <div class="archive-shell">
        <SectionHeading number="05" title="WEEKLY EDITIONS" subtitle="周间刊物 / 一周一页" href="/weekly/" linkText="全部周报" />
        {latest && latestWeek ? <div class="weekly-spread">
          <a class="weekly-edition" href={`/weekly/${latest.id}/`}><div class="edition-stamp"><span class="micro">LATEST EDITION / {latestWeek.isoYear}</span><strong><small>W</small>{latestWeek.number}</strong><span class="micro">{latestWeek.range}</span></div><div class="edition-copy"><h3>{latest.data.title}</h3><p>{latest.data.description}</p><span class="underlined-link">打开本期</span></div></a>
          <div class="edition-index"><p class="micro">PREVIOUS EDITIONS</p>{weekly.slice(1, 4).map((entry) => <a href={`/weekly/${entry.id}/`}><span class="edition-number">W{getWeekInfo(entry.data.weekOf).number}</span><div><h3>{entry.data.title}</h3><p>{getWeekInfo(entry.data.weekOf).range}</p></div></a>)}<p class="edition-note">开发中的进展、问题与新收获。<br />给每一周，留一点记录。</p></div>
        </div> : <p>第一期周报正在酝酿中。</p>}
      </div>
    </section>

    <section class="archive-shell home-work home-section" aria-label="项目记录">
      <SectionHeading number="06" title="SELECTED WORK" subtitle="项目记录 / 在真实问题中工作" href={siteInfo.profile} linkText="GitHub" />
      <p class="work-intro">从已有项目复盘中，观察系统如何连接真实世界。</p>
      <div class="work-index">{projects.map((post, index) => <a href={`/blog/${post.id}/`}><span class="work-number">{String(index + 1).padStart(2, "0")}</span><div><p class="micro">{post.data.tags.slice(0, 3).join(" / ")}</p><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="work-kind micro">PROJECT NOTES</span></a>)}</div>
      <div class="archive-activity"><div class="activity-heading"><h3>持续构建</h3><span class="micro">PUBLIC GITHUB ACTIVITY</span></div><GitHubContributions username="null0x0f" /></div>
    </section>

    <section class="home-after-hours home-section" id="after-hours" aria-labelledby="after-hours-title">
      <div class="archive-shell">
        <div class="section-label"><span class="section-number">07</span><span>AFTER HOURS / 代码之外</span></div>
        <div class="after-hours-spread">
          <div class="after-hours-copy"><h2 id="after-hours-title">OFF <br />THE <br /><span>CLOCK.</span></h2><p>有时调试代码，<br />有时只是，喜欢一张画。</p><span class="micro">A SMALL COLLECTION OF<br />THINGS I KEEP AROUND.</span></div>
          <div class="after-hours-collage">
            <figure class="collage-main"><img src="/images/bleach/pingzi.jpg" alt="戴耳机坐在书与唱片之间的 BLEACH 漫画人物" width="800" height="1176" loading="lazy" decoding="async" /><figcaption class="micro">BLEACH / PERSONAL COLLECTION</figcaption></figure>
            <figure class="collage-side"><img src="/images/bleach/bleach.jpg" alt="BLEACH 漫画人物群像" width="640" height="914" loading="lazy" decoding="async" /><figcaption class="micro">KEEP WHAT MOVES YOU.</figcaption></figure>
            <span class="collage-label" aria-hidden="true">NO DEADLINES.</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</EditorialLayout>
